# Optional overrides; Thunder client credentials come from .env.thunder (wso2/thunder/thunder-setup.sh).
# Values already set in the environment win over this file.

# Where the agent backend is reached by the browser (OAuth redirect URIs are built from it).
PUBLIC_URL=http://localhost:9100
# Set when the UI runs on the Vite dev server instead of the built bundle.
# UI_URL=http://localhost:5173

# Model: local Ollama by default; or the WSO2 AI gateway's OpenAI-compatible endpoint.
OLLAMA_MODEL=qwen3:1.7b
# LLM_BASE_URL=http://default-default.gateway.localhost:19080/ollama
# LLM_API_KEY_HEADER=X-API-Key
# LLM_API_KEY=<consumer key from the Agent Manager console>

# Thunder for server-to-server calls, when THUNDER_BASE (the browser-facing issuer) is not reachable from
# the agent, e.g. hosted in Agent Manager (see wso2/agent-manager.env.example).
# THUNDER_INTERNAL_URL=http://amp-thunder-default-default-service.amp-thunder-default-default.svc.cluster.local:8090

# MCP servers: direct (config/mcp_servers.json) or through the gateway (config/mcp_servers.wso2.json).
# MCP_CONFIG=config/mcp_servers.wso2.json
WSO2_GATEWAY_URL=http://default-default.gateway.localhost:19080

# Payments above this need MFA (read by the MCP servers).
HIGH_VALUE_LIMIT=500
