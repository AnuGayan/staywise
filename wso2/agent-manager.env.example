# Environment for the StayWise agent hosted in Agent Manager (platform-hosted agent, Docker build).
# Enter these in the console when creating the agent. Values in <angle brackets> come from
# .env.thunder (after wso2/thunder/thunder-setup.sh) or from the console; never commit the filled-in copy.
#
# The agent pod can reach only DNS, port 8090, the API gateway (port 22893 in-cluster) and the public
# internet, so Thunder, the MCP servers and the model are all reached through in-cluster addresses.

# --- plain environment variables ---------------------------------------------------------------
# Exactly the URL the console shows for the agent's endpoint (path included, no trailing slash).
PUBLIC_URL=http://default-default.agentmanager.localhost:19080/staywise
# Issuer as the browser sees it (sign-in redirects, the `iss` check) ...
THUNDER_BASE=http://default-idp.amp.localhost:8080
# ... and the same Thunder from inside the cluster (token and JWKS calls).
THUNDER_INTERNAL_URL=http://amp-thunder-default-default-service.amp-thunder-default-default.svc.cluster.local:8090
THUNDER_RESOURCE=urn:staywise:hotel-api
# MCP proxies, through the gateway's in-cluster service (config/mcp_servers.wso2.json appends /staywise-<name>/mcp).
WSO2_GATEWAY_URL=http://api-platform-default-default-gw-gateway-gateway-runtime.default-default.svc.cluster.local:22893
# The LLM provider created in the console for Ollama, through the same gateway service.
LLM_BASE_URL=http://api-platform-default-default-gw-gateway-gateway-runtime.default-default.svc.cluster.local:22893/<llm-provider-context>
LLM_API_KEY_HEADER=<header the LLM provider expects, e.g. X-API-Key>
OLLAMA_MODEL=qwen3:1.7b
WEB_CLIENT_ID=staywise-web
STEPUP_CLIENT_ID=staywise-stepup
AGENT_CLIENT_ID=staywise-concierge-agent
STEPUP_ACR=<STEPUP_ACR from .env.thunder>

# --- secrets (add as secret values, not plain variables) ---------------------------------------
WEB_CLIENT_SECRET=<from .env.thunder>
STEPUP_CLIENT_SECRET=<from .env.thunder>
AGENT_CLIENT_SECRET=<from .env.thunder>
MOCK_PHONE_KEY=<from .env.thunder>
LLM_API_KEY=<API key created for the LLM provider>
